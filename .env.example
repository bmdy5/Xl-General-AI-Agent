# ==============================================================================
# 🌟 XL Agent 全量配置示例文件 (.env.example) 🌟
# ==============================================================================
# 使用方法：请复制此文件为同一目录下的 .env 文件，并填入您的真实 API key 与鉴权凭证。
# 本文件包含大模型驱动核心、Stitch MCP 映射、QQ 消息网关 CSMA/CD 控制、本地/云端向量库等配置。
# ==============================================================================

# ------------------------------------------------------------------------------
# 🤖 1. MyAgent 核心大模型配置 (Core LLM Settings)
# ------------------------------------------------------------------------------
# 模型名称：遵循 LiteLLM 统一格式 (provider/model)
# 例如：openai/gpt-4o, deepseek/deepseek-chat, openai/mimo-v2.5-pro
MYAGENT_MODEL=openai/gpt-4o

# API 访问密钥 (Key)
MYAGENT_API_KEY=sk-your-api-key-here

# API 请求基础网关 URL (自建中转代理或标准 API 接入点)
# MYAGENT_API_BASE=https://your-api-proxy.com/v1

# 单次会话大模型 ReAct 决策循环的最大轮数 (Max Turns)，作为底层防陷入无限循环的硬防线
MYAGENT_MAX_TURNS=30

# ------------------------------------------------------------------------------
# 📡 2. QQ 消息网关控制与死锁规避 (QQ Gateway & CSMA/CD & Fatigue)
# ------------------------------------------------------------------------------
# 统一管理员 (主人) QQ 账号：
# 1. 享受私聊免疲劳度惩罚的特权。
# 2. 拥有发送“暂停私聊” / “恢复私聊”的物理冻结与解冻指令权限。
QQ_ADMIN_ID=1705919142

# 允许进行主动浮出及私聊触发的机器人/用户白名单 QQ 账号
MY_AGENT_WHITE_LIST=1911828529

# 载波监听与冲突检测 (CSMA/CD) 协议退避时长 (单位：秒，默认 2.0 秒)：
# 当网关监听到对方连续快速发送消息时，退避该秒数。只有当信道连续静默 2.0 秒后才会触发大模型逻辑。
# 这能极大规避多段碎碎念被多次重复触发、相互打断导致的消息雪崩问题。
QQ_CSMA_BACKOFF_SECONDS=2.0

# 脑力疲劳休眠打盹冷却时长 (单位：分钟，默认 15.0 分钟)：
# 当非管理员用户的交互导致小萤疲劳度累计达到或超过 100% 时，小萤将自发在大群/私聊发送高情商“打盹吐槽”，
# 随后进入物理打盹冷静隔离期，该阶段长为 15 分钟，期间物理隔离对普通消息的主动大模型分析与消耗。
QQ_FATIGUE_SLEEP_MINUTES=15.0

# 私聊/群聊回复疲劳计费扣分系数 (默认 0.4)：
# 发给非管理员消息的最终 Token 数量会乘以该系数计入对应群/私聊的脑力疲劳百分比。
# 值设得越大，扣分越快，能有效规避两个机器人互怼陷入死循环的算力耗尽。
QQ_FATIGUE_RATE=0.4

# ------------------------------------------------------------------------------
# 🔗 3. Google Stitch MCP 服务集成 (Stitch MCP Integration)
# ------------------------------------------------------------------------------
# Google Cloud 项目 ID
GOOGLE_CLOUD_PROJECT=stitch-496215

# Google Cloud Quota 项目 ID，提供配额控制
GOOGLE_CLOUD_QUOTA_PROJECT=stitch-496215

# Stitch API 鉴权密钥 (API Key)
STITCH_API_KEY=AIzaSyYourKeyHere

# 启动 Stitch MCP 代理的系统 CLI 命令，自动代理至外部工具集
STITCH_SERVER_CMD=npx @_davideast/stitch-mcp proxy

# Stitch 工具执行的超时切断阈值 (单位：秒)
STITCH_TIMEOUT=180

# ------------------------------------------------------------------------------
# 🧠 4. Embedding 向量检索模式 (Embedding & Vector Storage Mode)
# ------------------------------------------------------------------------------
# 向量模式选择：
#   - local: 0 Key、100% 纯本地离线计算，在 CPU 上惰性拉取并加载 m3e-base 模型，完全免费且极速。
#   - cloud: 云端 API 计算，使用 LiteLLM 走云端计费网络。
EMBEDDING_MODE=local

# ------------------------------------------------------------------------------
# 🍂 5. 备用大模型配置 (Backup Model Models)
# ------------------------------------------------------------------------------
# DeepSeek 官方 API 鉴权密钥（LiteLLM 自动读取此系统环境变量）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 快速低算力轻量级模型（主要用于分类、意图识别与 CSMA 预判）
MYAGENT_MODEL_FLASH=deepseek/deepseek-v4-flash

# 高智商复杂推理型模型（主要用于深度反思、长任务执行与代码分析）
MYAGENT_MODEL_PRO=deepseek/deepseek-v4-pro

# ------------------------------------------------------------------------------
# 🎨 6. Image2 像素纹理与生图中转站 (Image Generation Middleware)
# ------------------------------------------------------------------------------
# 生图中转服务器 API 根路径
IMAGE2_BASE=https://gpt-image2.xiaoliang.tech

# 中转站登录鉴权账户
IMAGE2_USER=admin

# 中转站登录鉴权密码
IMAGE2_PASS=your-password-here
