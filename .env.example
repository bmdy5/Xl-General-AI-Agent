# MyAgent 配置
# 复制此文件为 .env 并填入你的 API key

# 模型名称（LiteLLM 格式：provider/model）
# 例如：openai/gpt-4o, anthropic/claude-sonnet-4-6, deepseek/deepseek-chat
MYAGENT_MODEL=openai/gpt-4o

# API Key（支持各 provider 的环境变量）
MYAGENT_API_KEY=sk-your-api-key-here

# API Base URL（可选，自建代理或兼容 API 时使用）
# MYAGENT_API_BASE=https://your-api-proxy.com/v1

# 最大对话轮数（安全限制）
MYAGENT_MAX_TURNS=30
